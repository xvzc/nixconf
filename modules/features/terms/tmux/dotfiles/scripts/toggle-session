#!/usr/bin/env bash
set -euo pipefail

TOPIC=""
COMMAND=""

usage() {
  echo "usage: toggle-session --topic <prefix> [--command <cmd>]" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --topic)
      [[ $# -ge 2 ]] || usage
      TOPIC="$2"
      shift 2
      ;;
    --command)
      [[ $# -ge 2 ]] || usage
      COMMAND="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

[[ -n "$TOPIC" ]] || usage

session_id_for_name() {
  local requested_name="$1"
  local name session_id
  local format="#{session_name}"$'\t'"#{session_id}"

  while IFS=$'\t' read -r name session_id; do
    [[ "$name" == "$requested_name" ]] && {
      printf '%s\n' "$session_id"
      return 0
    }
  done < <(tmux list-sessions -F "$format")

  return 1
}

current_session="$(tmux display-message -p '#{session_name}')"
base_session="${current_session%%/*}"

if [[ "$current_session" == "$base_session/$TOPIC" ]]; then
  target_session="$base_session"
else
  target_session="$base_session/$TOPIC"

  if ! target_session_id="$(session_id_for_name "$target_session")"; then
    current_path="$(tmux display-message -p '#{pane_current_path}')"
    if [[ -n "$COMMAND" ]]; then
      # Chained so that a first pane which exits at once is still kept.
      tmux new-session -d -s "$target_session" -c "$current_path" "$COMMAND" \; \
        set-option default-command "$COMMAND" \; \
        set-option -w remain-on-exit failed \; \
        set-hook after-new-window 'set-option -w remain-on-exit failed'
    else
      tmux new-session -d -s "$target_session" -c "$current_path"
    fi
  fi
fi

target_session_id="$(session_id_for_name "$target_session")" || {
  echo "toggle-session: could not find session '$target_session'" >&2
  exit 1
}
tmux switch-client -t "$target_session_id"
