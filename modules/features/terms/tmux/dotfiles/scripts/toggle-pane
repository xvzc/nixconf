#!/usr/bin/env bash

# ------------------------------------------------------------------------------
# Default Configuration
# ------------------------------------------------------------------------------
TOPIC=""
LAUNCH_CMD=""
SIZE=33
FLOAT_SIZE="80x60" # --position float: WxH or N, in percent of the window
POSITION="right"
F_FLAG=""
TARGET_PANE=""

# ------------------------------------------------------------------------------
# Parse Command Line Arguments
# ------------------------------------------------------------------------------
while [[ "$#" -gt 0 ]]; do
  case $1 in
  --topic)
    TOPIC="$2"
    shift
    ;;
  --cmd)
    LAUNCH_CMD="$2"
    shift
    ;;
  --size)
    SIZE="$2"
    FLOAT_SIZE="$2"
    shift
    ;;
  --position)
    POSITION="$2"
    shift
    ;;
  --span)
    F_FLAG="-f" # Activates full window span flag
    ;;
  --target)
    TARGET_PANE="$2" # Specifies target pane direction
    shift
    ;;
  *)
    echo "Error: Unknown parameter passed: $1"
    exit 1
    ;;
  esac
  shift
done

# ------------------------------------------------------------------------------
# Validate Arguments & Set Flags
# ------------------------------------------------------------------------------
if [ -z "$TOPIC" ]; then
  echo "Error: --topic is required. Please specify a topic (e.g., --topic ai_agent)."
  exit 1
fi

case "$POSITION" in
left)
  SPLIT_FLAG="$F_FLAG -h -b"
  DIM_PROP="width"
  ;;
right)
  SPLIT_FLAG="$F_FLAG -h"
  DIM_PROP="width"
  ;;
top)
  SPLIT_FLAG="$F_FLAG -v -b"
  DIM_PROP="height"
  ;;
bottom)
  SPLIT_FLAG="$F_FLAG -v"
  DIM_PROP="height"
  ;;
float)
  if [[ ! "$FLOAT_SIZE" =~ ^([0-9]{1,3})(x([0-9]{1,3}))?$ ]]; then
    echo "Error: Invalid --size '$FLOAT_SIZE'. With --position float, use WxH or N in percent (e.g., 80x60 or 80)."
    exit 1
  fi
  FLOAT_W=$((10#${BASH_REMATCH[1]}))
  FLOAT_H=$((10#${BASH_REMATCH[3]:-${BASH_REMATCH[1]}}))
  if [ "$FLOAT_W" -lt 1 ] || [ "$FLOAT_W" -gt 100 ] || [ "$FLOAT_H" -lt 1 ] || [ "$FLOAT_H" -gt 100 ]; then
    echo "Error: Invalid --size '$FLOAT_SIZE'. Percentages must be between 1 and 100."
    exit 1
  fi
  # Centered in the window; --span and --target do not apply
  FLOAT_GEOMETRY=(-x "$FLOAT_W%" -y "$FLOAT_H%" -X "$(((100 - FLOAT_W) / 2))%" -Y "$(((100 - FLOAT_H) / 2))%")
  TARGET_PANE=""
  ;;
*)
  echo "Error: Invalid --position '$POSITION'. Use left, right, top, bottom, or float."
  exit 1
  ;;
esac

# ------------------------------------------------------------------------------
# Context Resolution
# ------------------------------------------------------------------------------
CUR_SESSION_NAME="$(tmux display-message -p '#{session_name}')"
CUR_WIN_ID="$(tmux display-message -p '#{window_id}')"

# A session named <base>/<topic> shares the pane of <base>. The = prevents tmux
# from resolving a missing <base> to <base>/<topic> by prefix.
BASE_SESSION="${CUR_SESSION_NAME%%/*}"
tmux has-session -t "=$BASE_SESSION" 2>/dev/null || BASE_SESSION="$CUR_SESSION_NAME"

# Formats target pane string
if [ -n "$TARGET_PANE" ]; then
  if [[ "$TARGET_PANE" != {* ]]; then
    TMUX_TARGET="${CUR_WIN_ID}.{${TARGET_PANE}}"
  else
    TMUX_TARGET="${CUR_WIN_ID}.${TARGET_PANE}"
  fi
else
  TMUX_TARGET="$CUR_WIN_ID"
fi

VAR_PANE_ID="@${TOPIC}_pane_id"
VAR_PANE_SIZE="@${TOPIC}_size"
HIDDEN_SESSION="__${TOPIC}_hidden"

# Provisions persistent background session
if ! tmux has-session -t "$HIDDEN_SESSION" 2>/dev/null; then
  tmux new-session -d -s "$HIDDEN_SESSION" -n "__keepalive" "sleep infinity"
fi

ensure_hidden_window() {
  if ! tmux list-windows -t "$HIDDEN_SESSION" -F '#{window_name}' 2>/dev/null | grep -q "^${BASE_SESSION}$"; then
    tmux new-window -d -t "$HIDDEN_SESSION:" -n "$BASE_SESSION" "sleep infinity"
  fi
}

# The pane moves between windows, and a window may keep dead panes
# (remain-on-exit, e.g. the agents session of toggle-session): a shell that
# exits with a failed last command (130 after C-c) would then leave a dead
# pane. A pane option overrides the window one, so set it on every show.
close_on_exit() {
  tmux set-option -p -t "$1" remain-on-exit off
}

resolve_target_dir() {
  # Extracts target directory path
  RAW_ENV=$(tmux show-environment -t "$CUR_SESSION_NAME" TMUX_SESSION_ROOT_DIR 2>/dev/null | grep "^TMUX_SESSION_ROOT_DIR=")
  TARGET_DIR="${RAW_ENV#TMUX_SESSION_ROOT_DIR=}"
  TARGET_DIR=$(echo "$TARGET_DIR" | tr -d '\r\n' | sed 's/^"//;s/"$//' | xargs)
  [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ] && TARGET_DIR=$(tmux display-message -p -t "$TMUX_TARGET" '#{pane_current_path}')
}

SAVED_PANE_ID=$(tmux show-option -t "$BASE_SESSION" -v "$VAR_PANE_ID" 2>/dev/null)

# Evaluates pane presence within target window
IS_VISIBLE=0
if [ -n "$SAVED_PANE_ID" ] && tmux list-panes -t "$CUR_WIN_ID" -F '#{pane_id}' 2>/dev/null | grep -q "^${SAVED_PANE_ID}$"; then
  IS_VISIBLE=1
fi

# ------------------------------------------------------------------------------
# Floating Pane
# ------------------------------------------------------------------------------
if [ "$POSITION" = "float" ]; then
  IS_ZOOMED=$(tmux display-message -p -t "$CUR_WIN_ID" '#{window_zoomed_flag}')
  ACTIVE_PANE=$(tmux display-message -p -t "$CUR_WIN_ID" '#{pane_id}')

  # A zoomed pane covers the floating pane, so toggling then shows it instead
  if [ "$IS_VISIBLE" -eq 1 ] && { [ "$IS_ZOOMED" -eq 0 ] || [ "$ACTIVE_PANE" = "$SAVED_PANE_ID" ]; }; then
    ensure_hidden_window
    tmux join-pane -d -v -s "$SAVED_PANE_ID" -t "${HIDDEN_SESSION}:${BASE_SESSION}"
    exit 0
  fi

  [ "$IS_ZOOMED" -eq 1 ] && tmux resize-pane -Z -t "$CUR_WIN_ID"

  if [ "$IS_VISIBLE" -eq 1 ]; then
    tmux select-pane -t "$SAVED_PANE_ID"
  elif [ -n "$SAVED_PANE_ID" ] && tmux list-panes -a -F '#{pane_id}' | grep -q "^${SAVED_PANE_ID}$"; then
    # Swapping into a floating placeholder leaves the tiled panes unresized. The
    # placeholder is active after new-pane, so run-shell -C resolves it as #{pane_id}.
    PLACEHOLDER=$(tmux new-pane -t "$CUR_WIN_ID" "${FLOAT_GEOMETRY[@]}" -P -F '#{pane_id}' "sleep 300" \; \
      run-shell -t "$CUR_WIN_ID" -C "swap-pane -d -s '$SAVED_PANE_ID' -t '#{pane_id}' ; kill-pane -t '#{pane_id}'") || {
      [ -n "$PLACEHOLDER" ] && tmux kill-pane -t "$PLACEHOLDER"
      exit 1
    }
  else
    resolve_target_dir
    LAUNCH_ARGS=()
    [ -n "$LAUNCH_CMD" ] && LAUNCH_ARGS=("$LAUNCH_CMD")
    NEW_ID=$(tmux new-pane -d -t "$CUR_WIN_ID" -c "$TARGET_DIR" "${FLOAT_GEOMETRY[@]}" -P -F '#{pane_id}' "${LAUNCH_ARGS[@]}") || exit 1
    tmux set-option -t "$BASE_SESSION" "$VAR_PANE_ID" "$NEW_ID"
    tmux select-pane -t "$NEW_ID"
  fi
  close_on_exit "${NEW_ID:-$SAVED_PANE_ID}"
  exit 0
fi

if [ "$IS_VISIBLE" -eq 1 ]; then
  IS_ZOOMED=$(tmux display-message -p '#{window_zoomed_flag}')

  if [ "$IS_ZOOMED" -eq 0 ]; then
    # Stores current pane dimension
    CURRENT_SIZE=$(tmux display-message -p -t "$SAVED_PANE_ID" "#{pane_${DIM_PROP}}")
    tmux set-option -t "$BASE_SESSION" "$VAR_PANE_SIZE" "$CURRENT_SIZE"
  else
    # Retrieves stored dimension to preserve layout during zoomed state
    CURRENT_SIZE=$(tmux show-option -t "$BASE_SESSION" -v "$VAR_PANE_SIZE" 2>/dev/null)
    # Assigns fallback dimension
    [ -z "$CURRENT_SIZE" ] && CURRENT_SIZE=20
  fi

  ensure_hidden_window

  # Migrates pane to hidden session
  tmux join-pane -d $SPLIT_FLAG -s "$SAVED_PANE_ID" -t "${HIDDEN_SESSION}:${BASE_SESSION}" -l "$CURRENT_SIZE"

  # Restores window split layout
  CURRENT_PANES=$(tmux display-message -p -t "$CUR_WIN_ID" '#{window_panes}')
  SAVED_PANES=$(tmux show-option -t "$CUR_SESSION_NAME" -v "@${TOPIC}_saved_panes" 2>/dev/null)

  if [ "$CURRENT_PANES" = "$SAVED_PANES" ]; then
    SAVED_LAYOUT=$(tmux show-option -t "$CUR_SESSION_NAME" -v "@${TOPIC}_saved_layout" 2>/dev/null)
    if [ -n "$SAVED_LAYOUT" ]; then
      tmux select-layout -t "$CUR_WIN_ID" "$SAVED_LAYOUT" 2>/dev/null
    fi
  fi
else
  SAVED_SIZE=$(tmux show-option -t "$BASE_SESSION" -v "$VAR_PANE_SIZE" 2>/dev/null)
  if [ -z "$SAVED_SIZE" ]; then
    # Determines base dimension using span flag condition
    if [ "$F_FLAG" = "-f" ]; then
      BASE_DIM=$(tmux display-message -p -t "$CUR_WIN_ID" "#{window_${DIM_PROP}}")
    else
      BASE_DIM=$(tmux display-message -p -t "$TMUX_TARGET" "#{pane_${DIM_PROP}}")
    fi

    TARGET_SIZE=$((BASE_DIM * SIZE / 100))
    [ "$TARGET_SIZE" -lt 10 ] && TARGET_SIZE=10
  else
    TARGET_SIZE="$SAVED_SIZE"
  fi

  # Saves current layout and pane count
  CURRENT_LAYOUT=$(tmux display-message -p -t "$CUR_WIN_ID" '#{window_layout}')
  CURRENT_PANES=$(tmux display-message -p -t "$CUR_WIN_ID" '#{window_panes}')
  tmux set-option -t "$CUR_SESSION_NAME" "@${TOPIC}_saved_layout" "$CURRENT_LAYOUT"
  tmux set-option -t "$CUR_SESSION_NAME" "@${TOPIC}_saved_panes" "$CURRENT_PANES"

  resolve_target_dir

  if [ -n "$SAVED_PANE_ID" ] && tmux list-panes -a -F '#{pane_id}' | grep -q "^${SAVED_PANE_ID}$"; then
    # Reattaches existing pane
    tmux join-pane $SPLIT_FLAG -s "$SAVED_PANE_ID" -t "$TMUX_TARGET" -l "$TARGET_SIZE"
    tmux select-pane -t "$SAVED_PANE_ID"
  else
    # Initializes new pane
    if [ -n "$LAUNCH_CMD" ]; then
      NEW_ID=$(tmux split-window -t "$TMUX_TARGET" -c "$TARGET_DIR" $SPLIT_FLAG -P -F '#{pane_id}' -l "$TARGET_SIZE" "$LAUNCH_CMD")
    else
      NEW_ID=$(tmux split-window -t "$TMUX_TARGET" -c "$TARGET_DIR" $SPLIT_FLAG -P -F '#{pane_id}' -l "$TARGET_SIZE")
    fi
    tmux set-option -t "$BASE_SESSION" "$VAR_PANE_ID" "$NEW_ID"
    tmux select-pane -t "$NEW_ID"
  fi
  close_on_exit "${NEW_ID:-$SAVED_PANE_ID}"
fi
