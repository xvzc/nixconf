#!/usr/bin/env bash

# Prints the name of the process a pane is really running, one line per given
# pane pid (an empty line when the pid is gone).
#
# Starts at the foreground process of the pane tty. A shell or (n)vim is the
# answer. Any other process (e.g. `devenv shell`, which runs the shell on a pty
# of its own) is followed into the foreground of a direct child on another tty.
# Shells are not followed, so zsh workers on their own ptys are skipped, and
# (n)vim is not followed into its :terminal.
#
# Usage: pane-process <pane-pid>...

ps -axo pid=,ppid=,tpgid=,tty=,comm= | awk -v pids="$*" '
{
  pid = $1
  tty[pid] = $4
  name = $5
  for (i = 6; i <= NF; i++) name = name " " $i
  comm[pid] = name
  kids[$2] = kids[$2] " " pid
  if ($1 == $3) fg[$4] = pid
}

function base(p,   n) {
  n = comm[p]
  sub(/.*\//, "", n)
  sub(/^-/, "", n)
  return n
}

function final(n) {
  return n ~ /^(sh|bash|zsh|fish|dash|ksh|tcsh|csh|nu)$/ ||
    n ~ /^g?\.?(view|n?vim?x?)(-wrapped)?(diff)?$/
}

function resolve(p,   f, d, n, a, i, c, next_f) {
  f = (tty[p] in fg) ? fg[tty[p]] : p
  for (d = 0; d < 16 && !final(base(f)); d++) {
    next_f = ""
    n = split(kids[f], a, " ")
    for (i = 1; i <= n; i++) {
      c = a[i]
      if (tty[c] != "??" && tty[c] != tty[f] && (tty[c] in fg)) {
        next_f = fg[tty[c]]
        break
      }
    }
    if (next_f == "") break
    f = next_f
  }
  return base(f)
}

END {
  n = split(pids, a, " ")
  for (i = 1; i <= n; i++) print((a[i] in tty) ? resolve(a[i]) : "")
}'
