#!/usr/bin/env bash

# Uses ~/.config/tmux/projects.json by default.
# Schema:
# {
#   "lookupDirs": ["~/personal"],
#   "named": {
#     "main": { "root": "~" },
#     "pi": {
#       "root": "~/.config/pi",
#       "env": { "PI_CODING_AGENT_DIR": "~/.config/pi/agent" }
#     }
#   }
# }
#
# All entries are unified: existing sessions prefixed with • and shown first.
# On select: switch to existing session, or create new one at the given root.

_start_ms=$(date +%s%3N)
_log_file="$(dirname "$0")/log"
trap 'printf "%s [switch-session] %dms\n" "$(date +"%Y-%m-%d %H:%M:%S")" "$(( $(date +%s%3N) - _start_ms ))" >> "$_log_file"' EXIT

projects_config="${TMUX_PROJECTS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/projects.json}"

if ! command -v jq >/dev/null 2>&1; then
  echo "switch-session: jq is required to read $projects_config" >&2
  exit 1
fi

if [[ ! -f "$projects_config" ]]; then
  echo "switch-session: projects config not found: $projects_config" >&2
  exit 1
fi

# Fire both tmux queries in parallel via process substitution
exec 3< <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
exec 4< <(tmux display-message -p '#S' 2>/dev/null)

in_array() {
  local needle="$1"
  shift
  for item; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

expand_value() {
  local value="$1"
  value="${value/#\~/$HOME}"
  value="${value//\$HOME/$HOME}"
  value="${value//\$\{HOME\}/$HOME}"
  printf '%s\n' "$value"
}

session_variable_names=()
session_variable_values=()

collect_session_variables() {
  local project_key="$1"
  local name value

  session_variable_names=()
  session_variable_values=()

  while IFS=$'\t' read -r name value; do
    [[ -n "$name" ]] || continue
    value="$(expand_value "$value")"
    session_variable_names+=("$name")
    session_variable_values+=("$value")
  done < <(
    jq -r --arg key "$project_key" '
      (.named[$key].env // {})
      | to_entries[]
      | [.key, (.value | tostring)]
      | @tsv
    ' "$projects_config"
  )
}

apply_session_variables() {
  local target_session="$1"
  local project_key="$2"
  local i

  collect_session_variables "$project_key"
  for ((i = 0; i < ${#session_variable_names[@]}; i++)); do
    tmux setenv -t "$target_session" "${session_variable_names[$i]}" "${session_variable_values[$i]}"
  done
}

named_names=()
named_paths_raw=()
lookup_names=()
lookup_paths_raw=()

_cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-switch-session"
_cache_key="$projects_config:$(jq -c '{lookupDirs:(.lookupDirs // []),named:(.named // {})}' "$projects_config" | cksum | awk '{print $1":"$2}')"

_cache_valid() {
  [[ -f "$_cache_file" ]] || return 1
  local stored_key
  IFS= read -r stored_key <"$_cache_file"
  [[ "$stored_key" == "#$_cache_key" ]] || return 1
  [[ "$projects_config" -nt "$_cache_file" ]] && return 1

  local _ldir
  while IFS= read -r _ldir; do
    _ldir="$(expand_value "$_ldir")"
    [[ -d "$_ldir" && "$_ldir" -nt "$_cache_file" ]] && return 1
  done < <(jq -r '.lookupDirs // [] | .[]' "$projects_config")

  return 0
}

if _cache_valid; then
  while IFS=$'\t' read -r _type _name _path; do
    [[ "$_type" == '#'* ]] && continue
    case "$_type" in
    N)
      named_names+=("$_name")
      named_paths_raw+=("$_path")
      ;;
    L)
      lookup_names+=("$_name")
      lookup_paths_raw+=("$_path")
      ;;
    esac
  done <"$_cache_file"
else
  while IFS=$'\t' read -r name root; do
    [[ -n "$name" && -n "$root" ]] || continue
    root="$(expand_value "$root")"
    [[ -d "$root" ]] || continue
    named_names+=("$name")
    named_paths_raw+=("$root")
  done < <(
    jq -r '
      .named // {}
      | to_entries[]
      | select(.value.root != null)
      | [.key, .value.root]
      | @tsv
    ' "$projects_config"
  )

  while IFS= read -r dir; do
    dir="$(expand_value "$dir")"
    [[ -d "$dir" ]] || continue
    for subdir in "$dir"/*/; do
      [[ -d "$subdir" ]] || continue
      lookup_names+=("$(basename "$subdir")")
      lookup_paths_raw+=("$subdir")
    done
  done < <(jq -r '.lookupDirs // [] | .[]' "$projects_config")

  mkdir -p "$(dirname "$_cache_file")"
  {
    printf '#%s\n' "$_cache_key"
    for ((i = 0; i < ${#named_names[@]}; i++)); do
      printf 'N\t%s\t%s\n' "${named_names[$i]}" "${named_paths_raw[$i]}"
    done
    for ((i = 0; i < ${#lookup_names[@]}; i++)); do
      printf 'L\t%s\t%s\n' "${lookup_names[$i]}" "${lookup_paths_raw[$i]}"
    done
  } >"$_cache_file"
fi

# Collect parallel tmux results (both have been running since the top)
mapfile -t existing <&3
exec 3<&-
current_session=$(cat <&4)
exec 4<&-

# Outside tmux, display-message may resolve #S to an unattached/default session.
# That is not the current client session, so do not filter it out.
[[ -z "$TMUX" ]] && current_session=""

if [[ -n "$TMUX" ]]; then
  if [[ "$current_session" == "scratch" || "$current_session" == opencode_* ]]; then
    tmux detach-client
  fi
fi

display_names=()
session_names=()
project_keys=()
paths=()

add_entry() {
  local display_name="$1"
  local session_name="$2"
  local project_key="$3"
  local path="$4"

  display_names+=("$display_name")
  session_names+=("$session_name")
  project_keys+=("$project_key")
  paths+=("$path")
}

for ((i = 0; i < ${#named_names[@]}; i++)); do
  session="${named_names[$i]//./_}"
  in_array "$session" "${existing[@]}" || continue
  [[ "$session" == "$current_session" ]] && continue
  add_entry "•${named_names[$i]}" "$session" "${named_names[$i]}" "${named_paths_raw[$i]}"
done
for ((i = 0; i < ${#lookup_names[@]}; i++)); do
  session="${lookup_names[$i]//./_}"
  in_array "$session" "${existing[@]}" || continue
  [[ "$session" == "$current_session" ]] && continue
  add_entry "•${lookup_names[$i]}" "$session" "" "${lookup_paths_raw[$i]}"
done
for ((i = 0; i < ${#named_names[@]}; i++)); do
  session="${named_names[$i]//./_}"
  in_array "$session" "${existing[@]}" && continue
  add_entry "${named_names[$i]}" "$session" "${named_names[$i]}" "${named_paths_raw[$i]}"
done
for ((i = 0; i < ${#lookup_names[@]}; i++)); do
  session="${lookup_names[$i]//./_}"
  in_array "$session" "${existing[@]}" && continue
  add_entry "${lookup_names[$i]}" "$session" "" "${lookup_paths_raw[$i]}"
done

[[ ${#display_names[@]} -eq 0 ]] && exit 0

session_name=""
project_key=""
workdir=""

if [[ -n "$1" ]]; then
  query="$1"
  for ((i = 0; i < ${#display_names[@]}; i++)); do
    label="${display_names[$i]#•}"
    if [[ "$label" == "$query" ]]; then
      session_name="${session_names[$i]}"
      project_key="${project_keys[$i]}"
      workdir="${paths[$i]%/}"
      break
    fi
  done
  if [[ -z "$session_name" ]]; then
    echo "switch-session: no session matching '$query'" >&2
    exit 1
  fi
else
  selected=$(
    printf '%s\n' "${display_names[@]}" |
      fzf-tmux \
        -p40,13 \
        --no-preview \
        --no-sort
  )

  [[ -z "$selected" ]] && exit 0

  selected_display="${selected#•}"

  for ((i = 0; i < ${#display_names[@]}; i++)); do
    label="${display_names[$i]#•}"
    if [[ "$label" == "$selected_display" ]]; then
      session_name="${session_names[$i]}"
      project_key="${project_keys[$i]}"
      workdir="${paths[$i]%/}"
      break
    fi
  done
fi

if [[ -n "$TMUX" ]]; then
  attach_cmd="switch-client"
  new_session_flag="-ds"
else
  attach_cmd="attach-session"
  new_session_flag="-s"
fi

if in_array "$session_name" "${existing[@]}"; then
  [[ -n "$project_key" ]] && apply_session_variables "$session_name" "$project_key"
  tmux "$attach_cmd" -t "$session_name"
else
  new_session_env_args=()
  if [[ -n "$project_key" ]]; then
    collect_session_variables "$project_key"
    for ((i = 0; i < ${#session_variable_names[@]}; i++)); do
      new_session_env_args+=("-e" "${session_variable_names[$i]}=${session_variable_values[$i]}")
    done
  fi

  tmux new-session "${new_session_env_args[@]}" "$new_session_flag" "$session_name" -c "$workdir"
  [[ "$workdir" != "$HOME" ]] &&
    tmux setenv -t "$session_name" TMUX_SESSION_ROOT_DIR "$workdir"
  [[ -n "$project_key" ]] && apply_session_variables "$session_name" "$project_key"
  [[ -n "$TMUX" ]] && tmux switch-client -t "$session_name"
fi
