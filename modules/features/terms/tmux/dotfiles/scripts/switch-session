#!/usr/bin/env bash

# Uses ~/.config/tmux/projects.json by default.
# Schema:
# {
#   "lookupDirs": ["~/personal"],
#   "named": {
#     "main": { "root": "~" },
#     "pi": {
#       "root": "~/.config/pi",
#       "env": { "PI_CODING_AGENT_DIR": "~/.config/pi/agent" }
#     }
#   }
# }
#
# All entries are unified as a tree: the current session first, then the other
# running sessions (except names outside the config starting with __) by
# session_last_attached, newest first, each in bold green and followed by all
# its panes, then projects not yet running, dim.
# A session named <base>/<topic>, split on the first /, is a bold green node
# above the panes of <base>, with its panes nested under it. Nodes are sorted by
# topic, and <base> is listed even when only <base>/<topic> is running.
# On select: switch to existing session, create new one at the given root, or
# jump to the selected pane.
# A pane is labeled by its agent, by the foreground process of @pane_tty (the
# tty of its shell, recorded by the zsh hook in the tmux module), or by its
# pane_current_command. An agent reads claude:<name>, cut to 16 columns, followed
# by its status, aligned across all agent rows in each view.
# Agents are Claude Code sessions (~/.claude/sessions/<pid>.json) mapped to a
# pane by walking up the process tree. Only "*.json" files are read; the
# neighbouring "*.key" files are never opened.
# The list shows the tree while the query is empty. With a query it shows the
# search view, a separate row field without tree glyphs where each pane row is
# prefixed by its session, cut to 20 columns.

_start_ms=$(date +%s%3N)
_log_file="$(dirname "$0")/log"
trap 'printf "%s [switch-session] %dms\n" "$(date +"%Y-%m-%d %H:%M:%S")" "$(( $(date +%s%3N) - _start_ms ))" >> "$_log_file"' EXIT

projects_config="${TMUX_PROJECTS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/projects.json}"

if ! command -v jq >/dev/null 2>&1; then
  echo "switch-session: jq is required to read $projects_config" >&2
  exit 1
fi

if [[ ! -f "$projects_config" ]]; then
  echo "switch-session: projects config not found: $projects_config" >&2
  exit 1
fi

# Fire both tmux queries in parallel via process substitution
exec 3< <(tmux list-sessions -F '#{session_last_attached} #{session_id} #{session_name}' 2>/dev/null)
exec 4< <(tmux display-message -p '#{pane_id} #{session_id} #S' 2>/dev/null)

# Sets REPLY to the session whose tree holds the given session.
session_group() {
  REPLY="$1"
  [[ "$REPLY" == ?*/?* ]] && REPLY="${REPLY%%/*}"
}

in_array() {
  local needle="$1"
  shift
  for item; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

expand_value() {
  local value="$1"
  value="${value/#\~/$HOME}"
  value="${value//\$HOME/$HOME}"
  value="${value//\$\{HOME\}/$HOME}"
  printf '%s\n' "$value"
}

session_variable_names=()
session_variable_values=()

collect_session_variables() {
  local project_key="$1"
  local name value

  session_variable_names=()
  session_variable_values=()

  while IFS=$'\t' read -r name value; do
    [[ -n "$name" ]] || continue
    value="$(expand_value "$value")"
    session_variable_names+=("$name")
    session_variable_values+=("$value")
  done < <(
    jq -r --arg key "$project_key" '
      (.named[$key].env // {})
      | to_entries[]
      | [.key, (.value | tostring)]
      | @tsv
    ' "$projects_config"
  )
}

apply_session_variables() {
  local target_session="$1"
  local project_key="$2"
  local i

  collect_session_variables "$project_key"
  for ((i = 0; i < ${#session_variable_names[@]}; i++)); do
    tmux setenv -t "$target_session" "${session_variable_names[$i]}" "${session_variable_values[$i]}"
  done
}

named_names=()
named_paths_raw=()
lookup_names=()
lookup_paths_raw=()

_cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-switch-session"
_cache_key="$projects_config:$(jq -c '{lookupDirs:(.lookupDirs // []),named:(.named // {})}' "$projects_config" | cksum | awk '{print $1":"$2}')"

_cache_valid() {
  [[ -f "$_cache_file" ]] || return 1
  local stored_key
  IFS= read -r stored_key <"$_cache_file"
  [[ "$stored_key" == "#$_cache_key" ]] || return 1
  [[ "$projects_config" -nt "$_cache_file" ]] && return 1

  local _ldir
  while IFS= read -r _ldir; do
    _ldir="$(expand_value "$_ldir")"
    [[ -d "$_ldir" && "$_ldir" -nt "$_cache_file" ]] && return 1
  done < <(jq -r '.lookupDirs // [] | .[]' "$projects_config")

  return 0
}

if _cache_valid; then
  while IFS=$'\t' read -r _type _name _path; do
    [[ "$_type" == '#'* ]] && continue
    case "$_type" in
    N)
      named_names+=("$_name")
      named_paths_raw+=("$_path")
      ;;
    L)
      lookup_names+=("$_name")
      lookup_paths_raw+=("$_path")
      ;;
    esac
  done <"$_cache_file"
else
  while IFS=$'\t' read -r name root; do
    [[ -n "$name" && -n "$root" ]] || continue
    root="$(expand_value "$root")"
    [[ -d "$root" ]] || continue
    named_names+=("$name")
    named_paths_raw+=("$root")
  done < <(
    jq -r '
      .named // {}
      | to_entries[]
      | select(.value.root != null)
      | [.key, .value.root]
      | @tsv
    ' "$projects_config"
  )

  while IFS= read -r dir; do
    dir="$(expand_value "$dir")"
    [[ -d "$dir" ]] || continue
    for subdir in "$dir"/*/; do
      [[ -d "$subdir" ]] || continue
      lookup_names+=("$(basename "$subdir")")
      lookup_paths_raw+=("$subdir")
    done
  done < <(jq -r '.lookupDirs // [] | .[]' "$projects_config")

  mkdir -p "$(dirname "$_cache_file")"
  {
    printf '#%s\n' "$_cache_key"
    for ((i = 0; i < ${#named_names[@]}; i++)); do
      printf 'N\t%s\t%s\n' "${named_names[$i]}" "${named_paths_raw[$i]}"
    done
    for ((i = 0; i < ${#lookup_names[@]}; i++)); do
      printf 'L\t%s\t%s\n' "${lookup_names[$i]}" "${lookup_paths_raw[$i]}"
    done
  } >"$_cache_file"
fi

# Collect parallel tmux results (both have been running since the top)
# running_groups marks the groups that have a running session.
# group_last_attached holds the newest attach among the sessions of a group.
declare -A session_ids running_groups group_last_attached
existing=()
while IFS= read -r line; do
  last_attached="${line%% *}"
  line="${line#* }"
  name="${line#* }"
  existing+=("$name")
  session_ids[$name]="${line%% *}"
  session_group "$name"
  running_groups[$REPLY]=1
  ((last_attached > ${group_last_attached[$REPLY]:-0})) && group_last_attached[$REPLY]="$last_attached"
done <&3
exec 3<&-
read -r current_pane current_session_id current_session <&4
exec 4<&-

# Outside tmux, display-message may resolve #S to an unattached/default session.
# That is not the current client session, so it must not be listed first or
# get the current-pane marker.
if [[ -z "$TMUX" ]]; then
  current_pane=""
  current_session_id=""
  current_session=""
fi
session_group "$current_session"
current_group="$REPLY"

if [[ -n "$TMUX" ]]; then
  if [[ "$current_session" == "scratch" || "$current_session" == opencode_* ]]; then
    tmux detach-client
  fi
fi

rows=()
entry_labels=()
session_names=()
project_keys=()
paths=()

# An empty display records the entry for name matching without listing it.
# The search view shows the display unless a separate one is given.
add_entry() {
  local display="$1"
  local label="$2"
  local session_name="$3"
  local project_key="$4"
  local path="$5"
  local search_display="${6:-$display}"

  [[ -n "$display" ]] &&
    rows+=("entry"$'\t'"${#entry_labels[@]}"$'\t'"$display"$'\t'"$search_display")
  entry_labels+=("$label")
  session_names+=("$session_name")
  project_keys+=("$project_key")
  paths+=("$path")
}

declare -A agent_names agent_statuses tty_foreground session_panes session_topics session_rows
pane_ids=()
pane_lefts=()
pane_statuses=()
pane_search_names=()
pane_tree_widths=()
pane_search_widths=()
agent_tree_width=0
agent_search_width=0
shown_sessions=()

# Prints "<pane_id>\t<name>\t<status>" for every live Claude session in tmux,
# outermost process first.
list_agents() {
  local f
  {
    tmux list-panes -a -F 'P	#{pane_pid}	#{pane_id}' 2>/dev/null
    awk '{print "S\t"$1"\t"$2}' <<<"$process_table"
    for f in "$HOME/.claude/sessions"/*.json; do
      [[ -f "$f" ]] || continue
      jq -r '
        select((.pid | type) == "number")
        | ["J", .pid,
           ((.name // "-") | tostring | gsub("[\\t\\r\\n]"; " ")),
           ((.status // "-") | tostring | gsub("[\\t\\r\\n]"; " "))]
        | @tsv
      ' "$f" 2>/dev/null
    done
  } | awk -F'\t' '
    $1 == "P" { pane[$2] = $3 }
    $1 == "S" { ppid[$2] = $3; alive[$2] = 1 }
    $1 == "J" { jpid[++n] = $2; jname[n] = ($3 == "" ? "-" : $3); jstatus[n] = ($4 == "" ? "-" : $4) }
    END {
      for (i = 1; i <= n; i++) {
        if (!(jpid[i] in alive)) continue
        p = jpid[i]
        for (d = 0; d < 64 && p != "" && p > 1 && !(p in pane); d++) p = ppid[p]
        if (!(p in pane)) continue
        printf "%s\t%s\t%s\t%s\n", pane[p], jname[i], jstatus[i], jpid[i]
      }
    }
  ' | sort -t$'\t' -s -k4,4n | cut -f1-3
}

collect_agents() {
  local pane name status

  process_table="$(ps -axo pid=,ppid=,tpgid=,tty=,comm=)"
  while IFS=$'\t' read -r pane name status; do
    [[ -n "${agent_names[$pane]+x}" ]] && continue
    agent_names[$pane]="${name//[[:cntrl:]]/ }"
    agent_statuses[$pane]="${status//[[:cntrl:]]/ }"
  done < <(list_agents)
}

# Sets REPLY to the value, cut to the given width with a closing …
truncate_column() {
  REPLY="$1"
  ((${#REPLY} > $2)) && REPLY="${REPLY:0:$2-1}…"
}

# A tty's foreground process is the one whose pid equals the tty's tpgid.
collect_foreground() {
  local tty comm

  while read -r _ _ _ tty comm; do
    tty_foreground[$tty]="$comm"
  done < <(awk '$1 == $3' <<<"$process_table")
}

collect_panes() {
  local sep=$'\x1f'
  local session pane command pane_tty left status name group tree_width search_width

  while IFS="$sep" read -r session pane command pane_tty; do
    session_group "$session"
    group="$REPLY"
    truncate_column "$session" 20
    pane_search_names+=("$REPLY")
    status=""
    if [[ -n "${agent_names[$pane]+x}" ]]; then
      status="${agent_statuses[$pane]}"
      name="${agent_names[$pane]}"
      left="claude"
      if [[ -n "$name" && "$name" != "-" ]]; then
        truncate_column "$name" 16
        left="claude:$REPLY"
      fi
      tree_width=$((${#left} + 3))
      [[ "$session" != "$group" ]] && tree_width=$((tree_width + 3))
      search_width=$((${#pane_search_names[-1]} + ${#left} + 3))
      [[ "$pane" == "$current_pane" ]] && search_width=$((search_width + 1))
      pane_tree_widths[${#pane_ids[@]}]="$tree_width"
      pane_search_widths[${#pane_ids[@]}]="$search_width"
      # Agents in sessions that are not listed do not widen the columns.
      if [[ "$group" != __* || "$group" == "$current_group" ]] ||
        in_array "$group" "${named_names[@]//./_}" "${lookup_names[@]//./_}"; then
        ((tree_width > agent_tree_width)) && agent_tree_width=$tree_width
        ((search_width > agent_search_width)) && agent_search_width=$search_width
      fi
    else
      name="$command"
      [[ -n "$pane_tty" ]] && name="${tty_foreground[${pane_tty#/dev/}]:-$command}"
      name="${name##*/}"
      name="${name#-}"
      truncate_column "${name//[[:cntrl:]]/ }" 20
      left="$REPLY"
    fi
    [[ "$session" != "$group" && -z "${session_panes[$session]}" ]] &&
      session_topics[$group]+="${session#*/}"$'\n'
    session_panes[$session]+="${#pane_ids[@]} "
    pane_ids+=("$pane")
    pane_lefts+=("$left")
    pane_statuses+=("$status")
  done < <(tmux list-panes -a -F "#{session_name}$sep#{pane_id}$sep#{pane_current_command}$sep#{@pane_tty}" 2>/dev/null)
}

add_pane_row() {
  local i="$1" glyph="$2"
  local left="${pane_lefts[$i]}" status="${pane_statuses[$i]}" search_name="${pane_search_names[$i]}"
  local tree_tail="" search_tail="" tree_separator=" " search_marker=""

  [[ "${pane_ids[$i]}" == "$current_pane" ]] && tree_separator="•" search_marker="•"
  if [[ -n "$status" ]]; then
    case "$status" in
    busy) status=$'\033[33m'"$status"$'\033[0m' ;;
    idle) status=$'\033[2m'"$status"$'\033[0m' ;;
    esac
    printf -v tree_tail '%*s  %s' "$((agent_tree_width - pane_tree_widths[i]))" '' "$status"
    printf -v search_tail '%*s  %s' "$((agent_search_width - pane_search_widths[i]))" '' "$status"
  fi
  rows+=("pane"$'\t'"${pane_ids[$i]}"$'\t'"$glyph$tree_separator$left$tree_tail"$'\t'$'\033[1;32m'"$search_name"$'\033[0m \033[2m→\033[0m '"$search_marker$left$search_tail")
}

# Adds the pane rows of a session. The last pane closes the branch.
add_pane_rows() {
  local session="$1" indent="$2"
  local indexes i last

  read -r -a indexes <<<"${session_panes[$session]}"
  last=$((${#indexes[@]} - 1))
  for ((i = 0; i <= last; i++)); do
    if ((i == last)); then
      add_pane_row "${indexes[$i]}" "${indent}└─"
    else
      add_pane_row "${indexes[$i]}" "${indent}├─"
    fi
  done
}

# Collects the rows of a running session, its topic nodes and its panes, to be
# placed by recency. Topic nodes come before the panes of the session.
add_running_session() {
  local name="$1" session="$2" project_key="$3" path="$4" entry_session="${5:-$2}"
  local first_row=${#rows[@]}
  local topics=() topic i last glyph indent

  if in_array "$session" "${shown_sessions[@]}"; then
    add_entry "" "$name" "$session" "$project_key" "$path"
    return
  fi
  shown_sessions+=("$session")

  add_entry $'\033[1;32m'"$name"$'\033[0m' "$name" "$entry_session" "$project_key" "$path"
  [[ -n "${session_topics[$session]}" ]] &&
    mapfile -t topics < <(printf '%s' "${session_topics[$session]}" | LC_ALL=C sort)
  last=$((${#topics[@]} - 1))
  for ((i = 0; i <= last; i++)); do
    topic="${topics[$i]}"
    glyph="├─" indent="│  "
    [[ $i -eq $last && -z "${session_panes[$session]}" ]] && glyph="└─" indent="   "
    add_entry "$glyph "$'\033[1;32m'"$topic"$'\033[0m' "$session/$topic" "$session/$topic" "" "" \
      $'\033[1;32m'"$session/$topic"$'\033[0m'
    add_pane_rows "$session/$topic" "$indent"
  done
  add_pane_rows "$session" ""

  local IFS=$'\n'
  session_rows[$session]="${rows[*]:first_row}"
  rows=("${rows[@]:0:first_row}")
}

# The argument path matches by session/project name only, so it skips panes.
if [[ -z "$1" ]]; then
  collect_agents
  collect_foreground
  collect_panes
fi

for ((i = 0; i < ${#named_names[@]}; i++)); do
  session="${named_names[$i]//./_}"
  [[ -n "${running_groups[$session]}" ]] || continue
  add_running_session "${named_names[$i]}" "$session" "${named_names[$i]}" "${named_paths_raw[$i]}"
done
for ((i = 0; i < ${#lookup_names[@]}; i++)); do
  session="${lookup_names[$i]//./_}"
  [[ -n "${running_groups[$session]}" ]] || continue
  add_running_session "${lookup_names[$i]}" "$session" "" "${lookup_paths_raw[$i]}"
done
if [[ -z "$1" ]]; then
  for session in "${existing[@]}"; do
    session_group "$session"
    group="$REPLY"
    in_array "$group" "${shown_sessions[@]}" && continue
    [[ "$group" == __* && "$group" != "$current_group" ]] && continue
    in_array "$group" "${existing[@]}" && session="$group"
    add_running_session "$group" "$group" "" "" "$session"
  done
fi
for ((i = 0; i < ${#named_names[@]}; i++)); do
  session="${named_names[$i]//./_}"
  in_array "$session" "${existing[@]}" "${shown_sessions[@]}" && continue
  add_entry $'\033[2m'"${named_names[$i]}"$'\033[0m' "${named_names[$i]}" "$session" "${named_names[$i]}" "${named_paths_raw[$i]}"
done
for ((i = 0; i < ${#lookup_names[@]}; i++)); do
  session="${lookup_names[$i]//./_}"
  in_array "$session" "${existing[@]}" "${shown_sessions[@]}" && continue
  add_entry $'\033[2m'"${lookup_names[$i]}"$'\033[0m' "${lookup_names[$i]}" "$session" "" "${lookup_paths_raw[$i]}"
done

running_rows=()
in_array "$current_group" "${shown_sessions[@]}" && mapfile -t -O 0 running_rows <<<"${session_rows[$current_group]}"
while IFS=$'\t' read -r _ session; do
  [[ "$session" == "$current_group" ]] && continue
  mapfile -t -O "${#running_rows[@]}" running_rows <<<"${session_rows[$session]}"
done < <(
  for session in "${shown_sessions[@]}"; do
    printf '%s\t%s\n' "${group_last_attached[$session]:-0}" "$session"
  done | LC_ALL=C sort -t$'\t' -k1,1nr -k2,2
)
rows=("${running_rows[@]}" "${rows[@]}")

[[ ${#rows[@]} -eq 0 ]] && exit 0

session_name=""
project_key=""
workdir=""

if [[ -n "$1" ]]; then
  query="$1"
  for ((i = 0; i < ${#entry_labels[@]}; i++)); do
    if [[ "${entry_labels[$i]}" == "$query" ]]; then
      session_name="${session_names[$i]}"
      project_key="${project_keys[$i]}"
      workdir="${paths[$i]%/}"
      break
    fi
  done
  if [[ -z "$session_name" ]]; then
    echo "switch-session: no session matching '$query'" >&2
    exit 1
  fi
else
  selected=$(
    printf '%s\n' "${rows[@]}" |
      fzf-tmux \
        -p70,30 \
        --delimiter=$'\t' \
        --with-nth=3 \
        --ansi \
        --layout=reverse \
        --with-shell="$BASH -c" \
        --bind="change:transform:[[ -n \$FZF_QUERY ]] && echo 'change-with-nth(4)' || echo 'change-with-nth(3)'" \
        --algo=v1 \
        --color='bg+:#3d4d66,fg+:#e0dada:regular,gutter:#313f54' \
        --highlight-line \
        --no-sort
  )

  [[ -z "$selected" ]] && exit 0

  IFS=$'\t' read -r selected_type selected_target _ <<<"$selected"

  if [[ "$selected_type" == "pane" ]]; then
    pane_session="$(tmux display-message -p -t "$selected_target" '#{session_id}' 2>/dev/null)" || exit 0
    select_pane=(select-window -t "$selected_target" \; select-pane -t "$selected_target")
    if [[ -z "$TMUX" ]]; then
      tmux "${select_pane[@]}" \; attach-session -t "$pane_session"
    elif [[ "$pane_session" == "$current_session_id" ]]; then
      tmux "${select_pane[@]}"
    else
      tmux switch-client -t "$pane_session" \; "${select_pane[@]}"
    fi
    exit 0
  fi

  session_name="${session_names[$selected_target]}"
  project_key="${project_keys[$selected_target]}"
  workdir="${paths[$selected_target]%/}"
fi

if [[ -n "$TMUX" ]]; then
  attach_cmd="switch-client"
else
  attach_cmd="attach-session"
fi

if in_array "$session_name" "${existing[@]}"; then
  session_id="${session_ids[$session_name]}"
  [[ -n "$project_key" ]] && apply_session_variables "$session_id" "$project_key"
  tmux "$attach_cmd" -t "$session_id"
else
  new_session_env_args=()
  if [[ -n "$project_key" ]]; then
    collect_session_variables "$project_key"
    for ((i = 0; i < ${#session_variable_names[@]}; i++)); do
      new_session_env_args+=("-e" "${session_variable_names[$i]}=${session_variable_values[$i]}")
    done
  fi

  if [[ -n "$TMUX" ]]; then
    session_id="$(tmux new-session "${new_session_env_args[@]}" -d -P -F '#{session_id}' -s "$session_name" -c "$workdir")"
  else
    tmux new-session "${new_session_env_args[@]}" -s "$session_name" -c "$workdir"
    session_id="$session_name"
  fi
  [[ "$workdir" != "$HOME" ]] &&
    tmux setenv -t "$session_id" TMUX_SESSION_ROOT_DIR "$workdir"
  [[ -n "$project_key" ]] && apply_session_variables "$session_id" "$project_key"
  [[ -n "$TMUX" ]] && tmux switch-client -t "$session_id"
fi
