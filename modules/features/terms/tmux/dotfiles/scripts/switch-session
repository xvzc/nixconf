#!/usr/bin/env bash

# TMUX_SESSION_DIRS: colon-separated entries, e.g. "(main)~:(pers)~/personal:~/dev"
#   (name)path → explicit session name + path
#   path       → basename of path used as session name
# TMUX_SESSION_LOOKUP_DIRS: colon-separated dirs to scan for depth-1 subdirs
#
# All entries are unified: existing sessions prefixed with • and shown first.
# On select: switch to existing session, or create new one at the given path.

_start_ms=$(date +%s%3N)
_log_file="$(dirname "$0")/log"
trap 'printf "%s [switch-session] %dms\n" "$(date +"%Y-%m-%d %H:%M:%S")" "$(( $(date +%s%3N) - _start_ms ))" >> "$_log_file"' EXIT

# Fire both tmux queries in parallel via process substitution
exec 3< <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
exec 4< <(tmux display-message -p '#S' 2>/dev/null)

in_array() {
  local needle="$1"
  shift
  for item; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

dirs_names=()
dirs_paths_raw=()
lookup_names=()
lookup_paths_raw=()

_cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-switch-session"
_cache_key="$TMUX_SESSION_DIRS:$TMUX_SESSION_LOOKUP_DIRS"

_cache_valid() {
  [[ -f "$_cache_file" ]] || return 1
  local stored_key
  IFS= read -r stored_key <"$_cache_file"
  [[ "$stored_key" == "#$_cache_key" ]] || return 1
  if [[ -n "$TMUX_SESSION_LOOKUP_DIRS" ]]; then
    IFS=':' read -ra _ldirs <<<"$TMUX_SESSION_LOOKUP_DIRS"
    for _ldir in "${_ldirs[@]}"; do
      _ldir="${_ldir/#\~/$HOME}"
      [[ "$_ldir" -nt "$_cache_file" ]] && return 1
    done
  fi
  return 0
}

if _cache_valid; then
  while IFS=$'\t' read -r _type _name _path; do
    [[ "$_type" == '#'* ]] && continue
    case "$_type" in
    D)
      dirs_names+=("$_name")
      dirs_paths_raw+=("$_path")
      ;;
    L)
      lookup_names+=("$_name")
      lookup_paths_raw+=("$_path")
      ;;
    esac
  done <"$_cache_file"
else
  re='^\(([^)]+)\)(.+)$'
  if [[ -n "$TMUX_SESSION_DIRS" ]]; then
    IFS=':' read -ra entries <<<"$TMUX_SESSION_DIRS"
    for entry in "${entries[@]}"; do
      entry="${entry## }"
      entry="${entry%% }"
      [[ -z "$entry" ]] && continue
      if [[ "$entry" =~ $re ]]; then
        name="${BASH_REMATCH[1]}"
        dir="${BASH_REMATCH[2]}"
      else
        dir="$entry"
        name="$(basename "${dir/#\~/$HOME}")"
      fi
      dir="${dir/#\~/$HOME}"
      [[ -n "$name" && -d "$dir" ]] || continue
      dirs_names+=("$name")
      dirs_paths_raw+=("$dir")
    done
  fi

  if [[ -n "$TMUX_SESSION_LOOKUP_DIRS" ]]; then
    IFS=':' read -ra lookup_dirs <<<"$TMUX_SESSION_LOOKUP_DIRS"
    for dir in "${lookup_dirs[@]}"; do
      dir="${dir/#\~/$HOME}"
      [[ -d "$dir" ]] || continue
      for subdir in "$dir"/*/; do
        [[ -d "$subdir" ]] || continue
        lookup_names+=("$(basename "$subdir")")
        lookup_paths_raw+=("$subdir")
      done
    done
  fi

  {
    printf '#%s\n' "$_cache_key"
    for ((i = 0; i < ${#dirs_names[@]}; i++)); do
      printf 'D\t%s\t%s\n' "${dirs_names[$i]}" "${dirs_paths_raw[$i]}"
    done
    for ((i = 0; i < ${#lookup_names[@]}; i++)); do
      printf 'L\t%s\t%s\n' "${lookup_names[$i]}" "${lookup_paths_raw[$i]}"
    done
  } >"$_cache_file"
fi

# Collect parallel tmux results (both have been running since the top)
mapfile -t existing <&3
exec 3<&-
current_session=$(cat <&4)
exec 4<&-

if [[ -n "$TMUX" ]]; then
  if [[ "$current_session" == "scratch" || "$current_session" == opencode_* ]]; then
    tmux detach-client
  fi
fi

display_names=()
session_names=()
paths=()

for ((i = 0; i < ${#dirs_names[@]}; i++)); do
  session="${dirs_names[$i]//./_}"
  in_array "$session" "${existing[@]}" || continue
  [[ "$session" == "$current_session" ]] && continue
  display_names+=("•${dirs_names[$i]}")
  session_names+=("$session")
  paths+=("${dirs_paths_raw[$i]}")
done
for ((i = 0; i < ${#lookup_names[@]}; i++)); do
  session="${lookup_names[$i]//./_}"
  in_array "$session" "${existing[@]}" || continue
  [[ "$session" == "$current_session" ]] && continue
  display_names+=("•${lookup_names[$i]}")
  session_names+=("$session")
  paths+=("${lookup_paths_raw[$i]}")
done
for ((i = 0; i < ${#dirs_names[@]}; i++)); do
  session="${dirs_names[$i]//./_}"
  in_array "$session" "${existing[@]}" && continue
  display_names+=("${dirs_names[$i]}")
  session_names+=("$session")
  paths+=("${dirs_paths_raw[$i]}")
done
for ((i = 0; i < ${#lookup_names[@]}; i++)); do
  session="${lookup_names[$i]//./_}"
  in_array "$session" "${existing[@]}" && continue
  display_names+=("${lookup_names[$i]}")
  session_names+=("$session")
  paths+=("${lookup_paths_raw[$i]}")
done

[[ ${#display_names[@]} -eq 0 ]] && exit 0

session_name=""
workdir=""

if [[ -n "$1" ]]; then
  query="$1"
  for ((i = 0; i < ${#display_names[@]}; i++)); do
    label="${display_names[$i]#•}"
    if [[ "$label" == "$query" ]]; then
      session_name="${session_names[$i]}"
      workdir="${paths[$i]%/}"
      break
    fi
  done
  if [[ -z "$session_name" ]]; then
    echo "switch-session: no session matching '$query'" >&2
    exit 1
  fi
else
  selected=$(
    printf '%s\n' "${display_names[@]}" |
      fzf-tmux \
        -p40,13 \
        --no-preview \
        --no-sort
  )

  [[ -z "$selected" ]] && exit 0

  selected_display="${selected#•}"

  for ((i = 0; i < ${#display_names[@]}; i++)); do
    label="${display_names[$i]#•}"
    if [[ "$label" == "$selected_display" ]]; then
      session_name="${session_names[$i]}"
      workdir="${paths[$i]%/}"
      break
    fi
  done
fi

if [[ -n "$TMUX" ]]; then
  attach_cmd="switch-client"
  new_session_flag="-ds"
else
  attach_cmd="attach-session"
  new_session_flag="-s"
fi

if in_array "$session_name" "${existing[@]}"; then
  tmux $attach_cmd -t "$session_name"
else
  tmux new-session $new_session_flag "$session_name" -c "$workdir"
  [[ "$workdir" != "$HOME" ]] &&
    tmux setenv -t "$session_name" TMUX_SESSION_ROOT_DIR "$workdir"
  [[ -n "$TMUX" ]] && tmux switch-client -t "$session_name"
fi
