#!/bin/zsh
# Open a new WezTerm window, or start WezTerm when it is not running.

# A socket inherited from some terminal session may point at a dead GUI; let wezterm find the live one.
unset WEZTERM_UNIX_SOCKET WEZTERM_PANE

if /usr/bin/pgrep -qx wezterm-gui; then
  wezterm cli spawn --new-window
else
  # `open` hands the caller's environment to the app, so start it from a clean one like Spotlight does.
  /usr/bin/env -i HOME="$HOME" USER="$USER" LOGNAME="$USER" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    /usr/bin/open -a "$HOME/Applications/Home Manager Apps/WezTerm.app"
fi
