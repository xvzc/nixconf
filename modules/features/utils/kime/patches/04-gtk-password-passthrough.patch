+  // Password/PIN fields: let GTK handle the key as is, like the built-in
+  // input methods do, so no Hangul is composed there.
+  GtkInputPurpose purpose = GTK_INPUT_PURPOSE_FREE_FORM;
+  g_object_get(im, "input-purpose", &purpose, NULL);
+  if (purpose == GTK_INPUT_PURPOSE_PASSWORD || purpose == GTK_INPUT_PURPOSE_PIN) {
+    debug("bypass: input-purpose %d", purpose);
+    return FALSE;
+  }
